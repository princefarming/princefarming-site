---
const pageTitle = "Princefarming | Official Site";
const latestRelease = {
  title: "Bleeding Star",
  type: "Single / EP",
  embedUrl: "https://bandcamp.com/EmbeddedPlayer/track=12345678/size=large/bgcol=ffffff/linkcol=0687f5/tracklist=false/transparent=true/"
};

import { getCollection } from 'astro:content';

// 1. Fetch posts and sort by pubDate (newest first)
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3); // Take the 3 most recent posts
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #111;
        color: #eee;
        margin: 0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      main { max-width: 650px; width: 100%; text-align: center; }
      h1 { font-size: 2.5rem; letter-spacing: -0.05em; text-transform: uppercase; }
      .player { margin: 2rem 0; width: 100%; height: 300px; border: none; }
      .links a { color: #fff; margin: 0 10px; text-decoration: underline; }
    </style>
  </head>
  <body>
    <main>
      <h1>Princefarming</h1>
      <p>Latest Release: <strong>{latestRelease.title}</strong></p>
      
	  <section class="splash-section">
        <p>
		  Back in the late 90s when I was creating a hotmail account I was looking 
		  for an alias to go by, at the time it seemed like a neat/cool thing. 
		  I remember reading a Life Magazine article that had a picture of 
		  Prince Charles bent over looking at a garden, the caption was 
		  "Prince Farming". The rest is Internet History.
		</p>
		<p>
			If you came here looking for stuff about me and where I work etc. please see me on
		</p>
        
      </section>
	  <!-- Recent News / Updates Feed -->
      <section class="news-section">
        <h2>Latest News</h2>
        {recentPosts.length === 0 ? (
          <p>No posts yet!</p>
        ) : (
          recentPosts.map((post) => (
            <article class="post-card">
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </span>
              <h3>
                <a href={`/news/${post.id.replace(/\.(md|mdx)$/, '')}/`}>
				{post.data.title}
				</a>
              </h3>
              <p class="post-desc">{post.data.description}</p>
            </article>
          ))
        )}
      </section>
      <!-- Replace iframe src with your actual Spotify/Bandcamp embed link -->
      <iframe class="player" src={latestRelease.embedUrl} loading="lazy"></iframe>

      <nav class="links">
        <a href="https://princefarming.bandcamp.com" target="_blank">Bandcamp</a>
        <a href="https://open.spotify.com/artist/1M1BOLXPmJnQrKQY0Yph3z?si=clv4txKiQHGWTT4HQPrSQg" target="_blank">Spotify</a>
        <a href="https://music.apple.com/us/artist/princefarming/6790264069" target="_blank">Apple Music</a>
      </nav>
    </main>
  </body>
</html>