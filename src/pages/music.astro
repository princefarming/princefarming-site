---
// src/pages/music.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const musicPage = await getEntry('pages', 'music');

// Safely handle missing entry
if (!musicPage) {
  throw new Error("Could not find 'music.md' in 'src/content/pages/'. Make sure the file exists!");
}

const { Content } = await render(musicPage);
---

<BaseLayout title={musicPage.data.title}>
  <section class="page-header">
    <h1>Music</h1>
    {musicPage.data.subtitle && <p class="subtitle">{musicPage.data.subtitle}</p>}
  </section>

  <article class="music-body">
    <Content />
  </article>
</BaseLayout>

