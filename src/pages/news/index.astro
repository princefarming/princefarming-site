---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout title="News & Updates | princefarming" description="Latest news and project updates.">
  <section class="page-header">
    <h1>News & Updates</h1>
    <p class="subtitle">Announcements, logs, and site updates.</p>
  </section>

  <div class="news-list">
    {posts.map((post) => (
      <article class="news-item">
        <header>
          <h2>
            <a href={`/news/${post.id}`}>{post.data.title}</a>
          </h2>
          <time>{post.data.pubDate}</time>
        </header>

        {post.data.image && (
          <a href={`/news/${post.id}`}>
            <img src={post.data.image} alt={post.data.title} class="news-image" />
          </a>
        )}

        {post.data.description && (
          <p class="description">{post.data.description}</p>
        )}

        <a href={`/news/${post.id}`} class="read-link">Read post &rarr;</a>
      </article>
    ))}
  </div>
</BaseLayout>

