---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | princefarming`} description={post.data.description}>
  <article class="single-post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <time class="post-date">{post.data.pubDate}</time>
    </header>

    {post.data.image && (
      <img 
        src={post.data.image.startsWith('/') ? post.data.image : `/${post.data.image}`} 
        alt={post.data.title} 
        class="featured-image"
      />
    )}

    <div class="post-body">
      <Content />
    </div>

    <footer class="post-footer">
      <a href="/news">&larr; Back to all news</a>
    </footer>
  </article>
</BaseLayout>

