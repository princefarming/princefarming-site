---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    // Strip extension (.md) so URLs match cleanly (e.g., 'princefarming-bio')
    const cleanId = post.id.replace(/\.(md|mdx)$/, '');

    return {
      params: { id: cleanId },
      props: { post },
    };
  });
}

const { post } = Astro.props;

// Render Markdown content using Astro 5's render() helper
const { Content } = await render(post);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{post.data.title}</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #111;
        color: #eee;
        margin: 0;
        padding: 2rem;
        display: flex;
        justify-content: center;
      }
      article { max-width: 650px; width: 100%; }
      a { color: #888; text-decoration: underline; }
      h1 { text-transform: uppercase; letter-spacing: -0.05em; }
      hr { border: 0; border-top: 1px solid #333; margin: 2rem 0; }
    </style>
  </head>
  <body>
    <article>
      <p><a href="/">&larr; Back to Home</a></p>
      <h1>{post.data.title}</h1>
      {post.data.pubDate && (
        <p><small>Published: {post.data.pubDate.toLocaleDateString()}</small></p>
      )}
      <hr />
      
      <!-- Renders your Markdown text as HTML -->
      <Content />
    </article>
  </body>
</html>