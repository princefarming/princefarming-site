 ---
// src/layouts/BaseLayout.astro
import '../styles/main.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "princefarming", 
  description = "Official news, releases, and updates." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/main.css" />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <div class="brand">
          <a href="/" class="site-title">princefarming</a>
        </div>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/news">News</a>
          <a href="/music">Music</a>
          <a href="/about">About</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>&copy; {new Date().getFullYear()} princefarming. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
  }

  .site-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text-primary);
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-nav a:hover {
    color: var(--text-primary);
  }

  .site-footer {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>